# Hugging Face token.
# Required for speaker diarization; plain transcription can run without it.
# Accept the terms of https://huggingface.co/pyannote/speaker-diarization-3.1 first.
HF_TOKEN=

# Bitrix24 webhooks shown as presets in the Web UI dropdown.
# Format: https://your-portal.bitrix24.ru/rest/<user_id>/<token>/
WEBHOOK_IT_TASK=
WEBHOOK_HR=
WEBHOOK_CALL_TRACK=
# Optional additional named webhook for the Web UI (kept out of UI preferences).
WEBHOOK_CUSTOM=

# API key passed to OpenAI-compatible LLM servers (LM Studio ignores it).
OPENAI_API_KEY=lm-studio

# Windows only: directory containing FFmpeg DLLs.
FFMPEG_DLL_PATH=C:\ffmpeg\bin

# In "auto" device mode, files longer than this (seconds) run on CPU
# instead of MPS on Apple Silicon to avoid unified-memory exhaustion.
# Set to 0 to disable the fallback.
MPS_LONG_FILE_THRESHOLD_SECONDS=600

# Bundled local LLM fallback (used by the CLI when LM Studio is unreachable):
# downloads llama.cpp + a GGUF model and runs llama-server on localhost.
LLAMA_PORT=1234
LLAMA_CTX=8192
# auto selects 4b / 8b / 14b from currently available RAM.
# Named profiles keep the RAM guard; manual uses your own repo/file without an estimate.
LLAMA_MODEL_PROFILE=auto
# For your own model, set LLAMA_MODEL_PROFILE=manual and uncomment BOTH:
# LLAMA_MODEL_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
# LLAMA_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# GPU layers offloaded to the accelerator (0 = CPU only, 99 = as many as possible).
LLAMA_NGPU=99
# Where llama.cpp binaries and the GGUF model are stored.
# LLAMA_CACHE_DIR=~/.cache/ai-transcriber

# Optional Bitrix24 smart-process integration. Copy values from your portal.
BITRIX_ENTITY_TYPE_ID=0
BITRIX_CATEGORY_ID=0
BITRIX_STAGE_ID=
BITRIX_ASSIGNEE_IDS=[]
# JSON mapping: portal field -> "summary", "assignees", "executor", or literal.
# Example: BITRIX_FIELDS_JSON='{"YOUR_SUMMARY_FIELD":"summary"}'
BITRIX_FIELDS_JSON={}

# Optional writable directory for web uploads, results and preferences.
# AI_TRANSCRIBER_DATA_DIR=./data

# Quantized KV cache reduces memory consumption. Set f16 if your backend needs it.
LLAMA_KV_CACHE_TYPE=q8_0

# Output budget for final summaries. Lower budget leaves more room for input.
LLM_MAX_OUTPUT_TOKENS=2000
